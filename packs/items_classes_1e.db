{"_id":"MviKBYaJbFyxdrhp","name":"Psychic","type":"class","img":"modules/fvtt_mosh_1e_psg/icons/armor/vaccsuit.png","system":{"description":"<p>Certain rare people have been manifesting strange psychic powers. Rumors abound about hyperspace side effects and secret corporate experiments, but no one truly knows why this is happening. Psychics are often treated with suspicion and fear unless someone wants to take advantage of their abilities.</p>","source":"Rimward Classes","author":"mechanoid23","link":"https://github.com/mechanoid23/fvtt_mosh_1e_rwc","trauma_response":"WHILE YOUR STRESS IS 10 OR HIGHER, YOUR PSIONICS ROLLS ARE AT [-]","robotic":false,"common_skills":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.Lv4musH6UKdLnkFB","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.PGTfaLeKzqiNZhMk","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.NbrnTP3fAbnFbmOH","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.Nwwmq6OLkTkx9NIQ","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.9G81aSQHqNgAC72q","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.AnHTmt9OBGhnuKon","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.p5B1Id9Z850kEnyd","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.zKG5mSoyPstUeC99","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.AraVNqTIAae24HZK","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.nYCsXoblu17rNy8H","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.yshA6P3MsHarAJOC","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.k7Gdp0CXP9K63LSF"],"base_adjustment":{"strength":0,"speed":0,"intellect":20,"combat":0,"sanity":-10,"fear":30,"body":0,"max_wounds":0,"skills_granted":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.Lv4musH6UKdLnkFB","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.PGTfaLeKzqiNZhMk"]},"selected_adjustment":{"choose_stat":[],"choose_skill_and":{"trained":0,"expert":0,"expert_full_set":0,"master":0,"master_full_set":0},"choose_skill_or":[[{"name":"Option: 1","trained":0,"expert":1,"expert_full_set":0,"master":0,"master_