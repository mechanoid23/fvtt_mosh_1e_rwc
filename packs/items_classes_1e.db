{"_id":"MG5dRVFYmDFXCszO","name":"Criminal","type":"class","img":"modules/fvtt_mosh_1e_psg/icons/armor/vaccsuit.png","system":{"description":"<p>Much of the Rim is far from the reach of anything resembling government oversight or corporate control. Criminal enterprises have found fertile ground to grow in these far reaches, and the desperate or unscrupulous flock to them.</p>","source":"Rimward Classes","author":"mechanoid23","link":"https://github.com/mechanoid23/fvtt_mosh_1e_rwc","trauma_response":"WHEN YOU MAKE A FEAR SAVE YOU CAN MAKE ANOTHER CLOSE FRIENDLY PLAYER MAKE IT INSTEAD OF YOU","robotic":false,"common_skills":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.9vkt2RBybSeuHoQQ","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.pxTk3Y9SDe0lU85j","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.NBA4JiYlWEnFCS3U","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.vNa4htmpXawfccpN","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.30dSaZxJc40A9V5r","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.beqj8DhIE1dd3Br6","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.sFLDbIg8KWWGnnio","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.e1rHSbZrEDFkjizS","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.WRGCkrN7TLSvW9Ls","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.ACtRFMZC05EnUSce","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.41CEH7dOvmTaywpD","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.lYEj5y8Kwkvumch3","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.rUu3BXzcG5NsUSCD","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.erO6jxrvrF94Fl3g"],"base_adjustment":{"strength":0,"speed":0,"intellect":0,"combat":5,"sanity":0,"fear":0,"body":10,"max_wounds":0,"skills_granted":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.9vkt2RBybSeuHoQQ"]},"selected_adjustment":{"choose_stat":[{"stats":["strength","speed"],"modification":5}],"choose_skill_and":{"trained":0,"expert":0,"expert_full_set":0,"master":0,"master_full_set":0},"choose_skill_or":[[{"name":"Comp