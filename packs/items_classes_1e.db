{"_id":"Vq0x9hIhRkw2pyhS","name":"Emissary","type":"class","img":"modules/fvtt_mosh_1e_psg/icons/armor/vaccsuit.png","system":{"description":"<p>Somewhere at the edge of the known Rim you were reborn, rebuilt, or maybe created whole cloth, found only with a strange item. By what, you don't remember, but you're pretty sure they are watching through your eyes with cold curiosity. Human by all accounts. You have your doubts.</p>","source":"Rimward Classes","author":"mechanoid23","link":"https://github.com/mechanoid23/fvtt_mosh_1e_rwc","trauma_response":"YOU ARE UNAFFECTED BY OTHER PLAYERS' TRAUMA RESPONSES","robotic":false,"common_skills":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.xvdvk1oi8J9XLwtY","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.ktwDDlbvtcXAIsK8","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.NbrnTP3fAbnFbmOH","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.Nwwmq6OLkTkx9NIQ","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.9G81aSQHqNgAC72q","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.AnHTmt9OBGhnuKon","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.p5B1Id9Z850kEnyd","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.zKG5mSoyPstUeC99","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.AraVNqTIAae24HZK","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.nYCsXoblu17rNy8H","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.yshA6P3MsHarAJOC","Compendium.fvtt_mosh_1e_rwc.items_skills_1e.Item.k7Gdp0CXP9K63LSF"],"base_adjustment":{"strength":0,"speed":0,"intellect":0,"combat":0,"sanity":30,"fear":30,"body":30,"max_wounds":0,"skills_granted":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.xvdvk1oi8J9XLwtY","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.ktwDDlbvtcXAIsK8"]},"selected_adjustment":{"choose_stat":[],"choose_skill_and":{"trained":2,"expert":0,"expert_full_set":0,"master":0,"master_full_set":0},"choose_skill_or":[[{"name":"Psionic Ability","trained":1,"expert":0,"expert_full_set":0,"master":0,"master_full_set":0,"from_list":[