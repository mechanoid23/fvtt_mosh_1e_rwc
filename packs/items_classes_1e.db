{"_id":"DuXWShCsmRs2OgYi","name":"Ranger","type":"class","img":"modules/fvtt_mosh_1e_psg/icons/armor/vaccsuit.png","system":{"description":"<p>Rangers are the ones they send to set foot on new worlds, answer distress calls, or otherwise be a first responder. Most rangers end up dying in horrible ways. The ones that survive tend to be tough enough to live through anything the universe throws at them.</p>","source":"Rimward Classes","author":"mechanoid23","link":"https://github.com/mechanoid23/fvtt_mosh_1e_rwc","trauma_response":"ONCE PER SESSION WHEN YOU PANIC, YOU CAN CHOOSE TO TAKE 2 STRESS INSTEAD","robotic":false,"common_skills":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.Ne7SnktJvl8bFQ3n","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.8bncFeOgoLIResHT","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.YqTFuG2lBWV4HlRC","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.smUuZPeixvfz8wyu","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.jG56DvDHbRzej0Mk","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.DRrQqYVtBTo0n8ck","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.kOp8yDKXROLGJdXn","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.fDT6QUy4Y6ti35uk","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.wcfanyJg5S9NNklg","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.Iabhy0eVM1J4qC9C","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.41CEH7dOvmTaywpD","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.vNa4htmpXawfccpN","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.30dSaZxJc40A9V5r","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.erO6jxrvrF94Fl3g","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.beqj8DhIE1dd3Br6"],"base_adjustment":{"strength":0,"speed":10,"intellect":5,"combat":0,"sanity":0,"fear":5,"body":5,"max_wounds":0,"skills_granted":["Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.Ne7SnktJvl8bFQ3n","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.8bncFeOgoLIResHT","Compendium.fvtt_mosh_1e_psg.items_skills_1e.Item.YqTFuG2lBWV4HlRC"]},"s