{"_id":"XuoYhDILjNF0b7kY","name":"Kalitec \"Traveler\" Spherecycle","type":"vehicle","img":"icons/svg/mystery-man.svg","system":{"health":{"value":5,"min":0,"max":5,"label":"Health"},"hits":{"value":0,"min":0,"max":2,"label":"Wounds"},"netHP":{"value":5,"min":0,"max":5,"label":"Net HP"},"bleeding":{"value":0,"min":0,"label":"Bleeding"},"biography":"","notes":"Optional sidecar expansion (+5,000cr) increases rider capacity to 3.","description":"<p><strong>Kalitec \"Traveler\" Spherecycle \u2014 25,000cr</strong></p><p>Patented pan-directional spherical \"wheels\" move this bike over a variety of terrain. Comes with small cargo storage. Optional sidecar expansion can be purchased for an additional 5,000cr, increasing rider capacity to three.</p>","type":"Ground Vehicle","topSpeed":"240kph / 150mph","range":"1 week","cost":25000,"crew":{"value":0,"max":2,"label":"Crew"},"weapons":{"value":0,"max":0,"label":"Weapons"},"stats":{"speed":{"value":240,"min":0,"max":999,"label":"Speed","rollLabel":"Speed Check"},"armor":{"value":5,"mod":0,"min":0,"max":99,"damageReduction":1,"cover":"partial","label":"Armor","rollLabel":"Armor Save"}}},"items":[],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"J8A2livbByJ3hnFM","name":"Tomida \"Helix\" Technical","type":"vehicle","img":"icons/svg/mystery-man.svg","system":{"health":{"value":15,"min":0,"max":15,"label":"Health"},"hits":{"value":0,"min":0,"max":2,"label":"Wounds"},"netHP":{"value":15,"min":0,"max":15,"label":"Net HP"},"bleeding":{"value":0,"min":0,"label":"Bleeding"},"biography":"","notes":"Optional: Mount a GPMG for an additional 10,000cr.","description":"<p><strong>Tomida \"Helix\" Technical \u2014 30,000cr</strong></p><p>These basic utility platforms converted to ad-hoc military vehicles enjoy popularity throughout the Rim for their durability and cost. Mount a GPMG for an additional 10,000cr.</p>","type":"Ground Vehicle","topSpeed":"160kph / 100mph","range":"1 week","cost":30000,"crew":{"value":0,"max":4,"label":"Crew"},"weapons":{"value":0,"max":1,"label":"Weapons"},"stats":{"speed":{"value":160,"min":0,"max":999,"label":"Speed","rollLabel":"Speed Check"},"armor":{"value":5,"mod":0,"min":0,"max":99,"damageReduction":1,"cover":"partial","label":"Armor","rollLabel":"Armor Save"}}},"items":[],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"Av6UoqepH56Rhv29","name":"LHS \"Camel\" Exploration Vehicle","type":"vehicle","img":"icons/svg/mystery-man.svg","system":{"health":{"value":15,"min":0,"max":15,"label":"Health"},"hits":{"value":0,"min":0,"max":3,"label":"Wounds"},"netHP":{"value":15,"min":0,"max":15,"label":"Net HP"},"bleeding":{"value":0,"min":0,"label":"Bleeding"},"biography":"","notes":"Vacuum-rated cabin with airlock. Basic air recycling and water filtration included. Equipped with long-range bioscanner, thermal sensors, and long-range comms.","description":"<p><strong>LHS \"Camel\" Exploration Vehicle \u2014 1,000,000cr</strong></p><p>Six-wheeled heavy duty exploration vehicle with a vacuum-rated cabin and airlock, allowing for extended travel in vacuum or uninhabitable atmosphere. Basic air recycling and water filtration systems are included. Equipped with long-range bioscanner, thermal sensors, and long-range comms.</p>","type":"Ground Vehicle","topSpeed":"100kph / 60mph","range":"1 week","cost":1000000,"crew":{"value":0,"max":8,"label":"Crew"},"weapons":{"value":0,"max":0,"label":"Weapons"},"stats":{"speed":{"value":100,"min":0,"max":999,"label":"Speed","rollLabel":"Speed Check"},"armor":{"value":15,"mod":0,"min":0,"max":99,"damageReduction":5,"cover":"full","label":"Armor","rollLabel":"Armor Save"}}},"items":[],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
