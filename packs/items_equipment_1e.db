{"_id":"GnBHxFDlKW5q621M","name":"Ammo","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/ammo.png","system":{"description":"<p>A supply of munitions, exploding substances, and projectiles that are put in guns, cannons, and other weapons.</p>","quantity":1,"weight":0,"cost":450},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"H3tGGe3I8lzbP8bS","name":"Assorted Tools","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/assorted_tools.png","system":{"description":"<p><strong>Wrenches, spanners, screwdrivers</strong>, etc. Can be used as weapons in a pinch, inflicting [[/r 1d5]] damage.</p>","quantity":1,"weight":0,"cost":20},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"f1ziki6bfnT0jcym","name":"Automed","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/automed.png","system":{"description":"<p>Nanotech pills that assist your body in repairing Damage by granting Advantage to Body Saves meant to repel disease and poison, as well as attempts to heal from rest.</p>","quantity":1,"weight":0,"cost":300},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"fNzHKUcg5VT0uP6P","name":"Battery (High Power)","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/battery_high_power.png","system":{"description":"<p>Heavy duty battery used for powering <strong>laser cutters, salvage drones,</strong> and other items. Can be recharged in 1 hour if connected to power or in 6 hours with solar power. Add <strong>waterproofing</strong> <em>(+500cr)</em>.</p>","quantity":1,"weight":0,"cost":500},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"a39zXRy6E5cTbDoA","name":"Binoculars","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/binoculars.png","system":{"description":"<p>20x magnification. Add <strong>night vision</strong> <em>(+300cr)</em> or <strong>thermal vision</strong> <em>(+1kcr).</em></p>","quantity":1,"weight":0,"cost":150},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"vBCc1NR9KyGy0eci","name":"Bioscanner","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/bioscanner.png","system":{"description":"<p>Long Range. Allows the user to scan for signs of life. Can tell the location of signs of life, but not what that life is. Blocked by some materials at the Warden\u2019s discretion.</p>","quantity":1,"weight":0,"cost":3000},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"EuaVN5enhMTMonXh","name":"Body Cam","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/body_cam.png","system":{"description":"<p>A camera worn on your clothing that can stream video back to a control center so your other crewmembers can see what you\u2019re seeing. Add <strong>night vision</strong> <em>(+300cr)</em> or <strong>thermal vision</strong> <em>(+1kcr).</em></p>","quantity":1,"weight":0,"cost":50},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"cw4fuKNTH5oXcvYW","name":"Briefcase","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/briefcase.png","system":{"description":"<p>A narrow hard-sided box-shaped bag or case used mainly for carrying papers and equipped with a handle.</p>","quantity":1,"weight":0,"cost":60},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"COXIh1YyOTYWICFp","name":"Camping Gear","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/camping_gear.png","system":{"description":"<p>A collection of camping-related equipment. Examples include a tent, sleeping bags, and a cook set.</p>","quantity":1,"weight":0,"cost":80},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"68X3lspUGatbSqQa","name":"Cat","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/cat.png","system":{"description":"<p>An animal with a strong flexible body, quick reflexes, sharp teeth, and retractable claws adapted to killing small prey like mice and rats. Its night vision and sense of smell are well developed.</p>","quantity":1,"weight":0,"cost":15000},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"NpVPgi5XxNlAuKd4","name":"Challenge Coin","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/challenge_coin.png","system":{"description":"<p>A small coin or medallion, bearing an organization's insignia or emblem and carried by the organization's members.</p>","quantity":1,"weight":0,"cost":50},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id":"1jjzx6qiCpq3dZcC","name":"Chemlight","type":"item","img":"modules/fvtt_mosh_1e_psg/icons/equipment/chemlight.png","system":{"description":"<p>Small disposable glowsticks capable of dim illumination in a 1m radius.</p>","quantity":1,"weight":0,"cost":1},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
